{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realtime-black",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "call.thinkwithblack.com", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://call.thinkwithblack.com",
    "ECCAL_ORIGIN": "https://eccal.thinkwithblack.com",
    "REALTIME_MODEL": "gpt-realtime-2.1",
    "TEXT_MODEL": "gpt-6.1-sol"
  },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "MEMBERS", "class_name": "MemberRoom" }, { "name": "CUTOFFS", "class_name": "CallCutoff" }, { "name": "AUTH", "class_name": "AuthVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MemberRoom", "CallCutoff"] }, { "tag": "v2", "new_sqlite_classes": ["AuthVault"] }],
  "observability": { "enabled": false }
}
