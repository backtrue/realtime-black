{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realtime-black-check-574d47a6",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://realtime-black-check-574d47a6.example.test",
    "ECCAL_ORIGIN": "",
    "REALTIME_MODEL": "gpt-realtime-2.1",
    "TEXT_MODEL": "gpt-6.1-sol"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMBERS",
        "class_name": "MemberRoom"
      },
      {
        "name": "CUTOFFS",
        "class_name": "CallCutoff"
      },
      {
        "name": "AUTH",
        "class_name": "AuthVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MemberRoom",
        "CallCutoff"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AuthVault"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
