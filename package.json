{
  "name": "realtime-black",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "node --test test/frontend.node.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "example:handoff": "node scripts/handoff-example.mjs",
    "check": "npm run typecheck && npm test && npm run test:frontend && npm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
